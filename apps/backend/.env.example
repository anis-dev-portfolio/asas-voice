# Clé API Mistral (Voxtral) — NE JAMAIS committer le vrai fichier .env.
# Obtenir une clé : https://console.mistral.ai/
MISTRAL_API_KEY=

# Clé API Anthropic (post-traitement Claude, optionnel) — injectée par l'app depuis
# le trousseau OS en prod ; utile ici seulement pour un test backend isolé.
# ANTHROPIC_API_KEY=

# Port d'écoute du backend local (défaut : 4321)
PORT=4321

# (Optionnel) Modèle de transcription Voxtral (apps/backend/src/env.ts). Défaut : voxtral-mini-latest
# VOXTRAL_MODEL=voxtral-mini-latest

{
  "name": "asas-voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @asas-voice/backend dev",
    "dev:desktop": "pnpm --filter @asas-voice/desktop tauri dev",
    "build": "pnpm -r build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@yao-pkg/pkg": "^6.3.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0"
  }
}
